# ── YouCam API (https://yce.perfectcorp.com/api-console) ──────────────────────
# Without a key, scans run in demo mode with simulated readings.
YOUCAM_API_KEY=
# YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# ── Clerk (https://dashboard.clerk.com) ──────────────────────────────────────
# Leave empty to run as a single demo user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ── Neon Postgres (https://console.neon.tech) ────────────────────────────────
# Leave empty to use the seeded in-memory demo store.
DATABASE_URL=
